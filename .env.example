# Copy to .env and fill in. .env is git-ignored — never commit real values.

# ---- required -------------------------------------------------------------
# Single password for the web UI (min 10 chars).
LEADHUB_PASSWORD=
# Random string that signs session cookies; without it you're logged out on every restart.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
LEADHUB_SECRET_KEY=

# ---- web server -------------------------------------------------------------
# LEADHUB_HOST=127.0.0.1         # keep localhost unless behind an HTTPS reverse proxy
# LEADHUB_PORT=8000
# LEADHUB_COOKIE_SECURE=0        # set 1 when served over HTTPS
# LEADHUB_SESSION_HOURS=336
# LEADHUB_DATA_DIR=./data        # sqlite db + telegram session live here

# ---- scoring ----------------------------------------------------------------
# MIN_SCORE=5                    # store posts scoring at least this (max 12)
# LEADHUB_KEYWORDS_FILE=./keywords.json
# POLL_SECONDS=300               # RSS/Reddit poll interval (min 60)

# ---- RSS (works without any keys) ------------------------------------------
# Comma-separated public feeds. Do not add Upwork/Fiverr-style bidding platforms.
# The Reddit one is a single combined feed on purpose: separate requests get HTTP 429. It brings one-off gigs.
# Habr Career is a vacancy board (not Habr Freelance, which is a bidding site).
RSS_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss,https://weworkremotely.com/categories/remote-full-stack-programming-jobs.rss,https://weworkremotely.com/categories/remote-back-end-programming-jobs.rss,https://weworkremotely.com/categories/remote-front-end-programming-jobs.rss,https://weworkremotely.com/categories/remote-devops-sysadmin-jobs.rss,https://jobicy.com/?feed=job_feed&job_categories=dev,https://hnrss.org/jobs,https://hnrss.org/whoishiring/jobs,https://www.python.org/jobs/feed/rss/,https://career.habr.com/vacancies/rss?type=all&remote=true,https://cryptojobslist.com/rss,https://nodesk.co/remote-jobs/index.xml,https://www.reddit.com/r/forhire+slavelabour+DoneDirtCheap+Jobs4Bitcoins+hiring+RemoteJobs+PythonJobs+remotepython+DevJobs+jobbit+WebDeveloperJobs+codingjobs+devopsjobs+techjobs+ProgrammingJobs/new.rss?limit=100

# ---- Reddit (read-only API; create a "script" app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=python:leadhub-personal:1.0 (by /u/your_username)
# REDDIT_SUBREDDITS=forhire,slavelabour,DoneDirtCheap

# ---- Telegram user client (read-only; https://my.telegram.org → API development tools)
TG_API_ID=
TG_API_HASH=
# Optional: limit to specific chats you are ALREADY a member of (usernames, @names, ids or titles).
# Empty = all groups/channels in your account. Chats you're not in are skipped, never joined.
# TG_BACKFILL_HOURS=24         # on start, re-read this much recent chat history (0 = off)
# TG_CHATS=@some_dev_jobs_chat,-1001234567890

# ---- Telegram Bot API (push notifications to YOU only) ---------------------
# Create a bot with @BotFather, send it /start, then put your own chat id here.
TG_BOT_TOKEN=
TG_NOTIFY_CHAT_ID=
# NOTIFY_MIN_SCORE=8

# ---- OpenStreetMap ----------------------------------------------------------
# Nominatim's policy requires an identifying User-Agent; add a contact URL if you like.
# OSM_USER_AGENT=LeadHub/1.0 (personal single-user lead tracker)
